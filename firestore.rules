rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function event(e) { return get(/databases/$(database)/documents/events/$(e)); }
  function owner(e) { return signed() && event(e).data.ownerId == request.auth.uid; }
  function member(e) { return signed() && exists(/databases/$(database)/documents/events/$(e)/team/$(request.auth.uid)); }
  function staff(e) { return owner(e) || member(e); }
  function attendee(e) { return signed() && exists(/databases/$(database)/documents/events/$(e)/participants/$(request.auth.uid)); }
  match /events/{e} {
   allow create: if signed() && request.resource.data.ownerId == request.auth.uid;
   allow read: if resource.data.visibility == 'public' || staff(e);
   allow update, delete: if owner(e) && request.resource.data.ownerId == resource.data.ownerId;
   match /participants/{p} {
    allow read: if staff(e) || (signed() && request.auth.uid == p);
    allow write: if false;
   }
   match /polls/{p} {
    allow read: if staff(e) || attendee(e);
    allow create, update, delete: if owner(e);
   }
   match /polls/{p}/votes/{v} { allow read, write: if false; }
   match /messages/{m} {
    allow read: if staff(e) || (attendee(e) && resource.data.status == 'approved');
    allow create, update, delete: if false;
   }
   match /media/{m} {
    allow read: if staff(e) || (attendee(e) && resource.data.status == 'approved');
    allow create, update, delete: if false;
   }
   match /team/{u} {
    allow read: if staff(e);
    allow write: if false;
   }
   match /{sub}/{doc} {
    allow read: if staff(e) && sub in ['schedules','sponsors','analytics'];
    allow write: if owner(e) && sub in ['schedules','sponsors'];
   }
  }
  match /templates/{id} {
   allow read: if resource.data.published == true;
   allow write: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
